<launch>
	<!-- Arguments参数 -->
  <arg name="car_mode"  default="senior_mec_bs" 
       doc="opt: senior_akm,senior_mec_bs,senior_mec_dl"/>
  <!-- 内部变量：是否重复加载，默认false -->
  <arg name="repeat" default="false"/>
  <arg name="is_cartographer" default="false"/>

  <!-- 0. 启动STM32控制板驱动接口 -->
  <include file="$(find driver)/launch/car_driver.launch" /> 

  <!-- 1. 发布用于建图、导航的TF关系与小车外形可视化 -->
  <include file="$(find start_roscar)/launch/robot_model_visualization.launch" unless="$(arg repeat)">
    <arg name="car_mode" value="$(arg car_mode)"/>
  </include>

  <!-- 2. 扩张卡尔曼滤波 -->
  <include file="$(find start_roscar)/launch/include/robot_pose_ekf.launch" unless="$(arg repeat)">
    <arg name="is_cartographer" value="$(arg is_cartographer)"/>
  </include>

  <!-- 3. 激光雷达 RPLidar A3 -->
  <!-- 默认雷达装在 base_link 上方，这里发布一个静态 TF（x y z yaw pitch roll） -->
  <include file="$(find rplidar_ros)/launch/rplidar_a3.launch" />


	<!-- 测试参数 -->
	<arg name="video_device" default="/dev/video0" />
	<arg name="image_width" default="640" />
	<arg name="image_height" default="480" />
	<arg name="pixel_format" default="yuyv" />
	<arg name="model_path" default="best.pt" />
	<arg name="show_image" default="false" />
	<arg name="dump_full_scan" default="false" doc="输出全部雷达原始 [角度, 距离] 数据到 lidar_ranges.txt，用于标定" />

	<!-- USB 摄像头 -->
	<node name="usb_cam" pkg="usb_cam" type="usb_cam_node" output="screen">
		<param name="video_device" value="$(arg video_device)" />
		<param name="image_width" value="$(arg image_width)" />
		<param name="image_height" value="$(arg image_height)" />
		<param name="pixel_format" value="$(arg pixel_format)" />
		<param name="camera_frame_id" value="usb_cam" />
		<param name="io_method" value="mmap" />
		<remap from="/usb_cam/image_raw/compressed" to="/image_raw/compressed" />
	</node>

	<!-- YOLO 红绿灯检测 -->
	<node name="traffic_light_yolov8_node"
				pkg="traffic_light_yolo"
				type="traffic_light_yolo.py"
				output="screen">
		<env name="LD_PRELOAD" value="/usr/lib/aarch64-linux-gnu/libgomp.so.1" />
		<param name="model_path" value="$(find traffic_light_yolo)/models/best.pt" />
		<param name="dump_full_scan" value="$(arg dump_full_scan)" />
	</node>

	<!-- 可选：查看原始相机画面 -->
	<node if="$(arg show_image)"
				name="image_view"
				pkg="image_view"
				type="image_view"
				args="image:=/usb_cam/image_raw"
				output="screen" />
</launch>
