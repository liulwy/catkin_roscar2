<launch>
	<!-- 测试参数 -->
	<arg name="video_device" default="/dev/video0" />
	<arg name="image_width" default="640" />
	<arg name="image_height" default="480" />
	<arg name="pixel_format" default="yuyv" />
	<arg name="model_path" default="best.pt" />
	<arg name="show_image" default="false" />

	<!-- USB 摄像头 -->
	<node name="usb_cam" pkg="usb_cam" type="usb_cam_node" output="screen">
		<param name="video_device" value="$(arg video_device)" />
		<param name="image_width" value="$(arg image_width)" />
		<param name="image_height" value="$(arg image_height)" />
		<param name="pixel_format" value="$(arg pixel_format)" />
		<param name="camera_frame_id" value="usb_cam" />
		<param name="io_method" value="mmap" />
		<remap from="/usb_cam/image_raw/compressed" to="/image_raw/compressed" />
	</node>

	<!-- YOLO 红绿灯检测 -->
	<node name="traffic_light_yolov8_node"
				pkg="traffic_light_yolo"
				type="traffic_light_yolo.py"
				output="screen">
		<env name="LD_PRELOAD" value="/usr/lib/aarch64-linux-gnu/libgomp.so.1" />
		<param name="model_path" value="$(find traffic_light_yolo)/models/best.pt" />
	</node>

	<!-- 可选：查看原始相机画面 -->
	<node if="$(arg show_image)"
				name="image_view"
				pkg="image_view"
				type="image_view"
				args="image:=/usb_cam/image_raw"
				output="screen" />
</launch>
