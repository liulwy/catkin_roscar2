<launch>
  <!-- ============================================================ -->
  <!--  路径录制 + 键盘遥控 Launch 文件                                -->
  <!--  启动：底盘驱动 + 传感器 + 键盘遥控（支持路径录制）               -->
  <!--                                                              -->
  <!--  操作说明：                                                     -->
  <!--    WASD 开车，q 退出                                           -->
  <!--    r=开始/暂停录制  p=保存路径  c=清除录制                        -->
  <!--    路径保存位置: $(find start_roscar)/path/patrol_path.yaml     -->
  <!-- ============================================================ -->

  <!-- 1. 启动底盘与传感器（STM32 / LiDAR / EKF / USB摄像头 / TF） -->
  <include file="$(find start_roscar)/launch/start_roscar.launch"/>

  <!-- 2. 地图服务器（发布预建地图到 /map） -->
  <node pkg="map_server" type="map_server" name="map_server_roscar" args="$(find start_roscar)/map/roscar_map.yaml" output="screen"/>

  <!-- 3. AMCL 定位（激光匹配地图，发布 map→odom TF） -->
  <include file="$(find start_roscar)/launch/include/amcl.launch" />

  <!-- 4. 键盘遥控 + 路径录制 -->
  <node pkg="start_roscar"
        type="keyboard_teleop.py"
        name="keyboard_teleop"
        output="screen">
    <!-- 驾驶参数 -->
    <param name="linear"       value="0.15"/>
    <param name="angular"      value="0.8"/>
    <param name="linear_step"  value="0.02"/>
    <param name="angular_step" value="0.05"/>
    <!-- 路径录制保存目录 -->
    <param name="save_dir" value="$(find start_roscar)/path"/>
  </node>

</launch>
