<launch>
  <!-- ===================== -->
  <!-- 1. 启动机器人底层 -->
  <!-- ===================== -->
  <include file="$(find start_roscar)/launch/start_roscar.launch" />

  <!-- ===================== -->
  <!-- 3. 地图服务器 -->
  <!-- ===================== -->
  <arg name="map_file" default="$(find start_roscar)/map/roscar_map.yaml"/>
  <arg name="traffic_light_model_path" default="$(find traffic_light_yolo)/models/best.pt"/>
  <node pkg="map_server" type="map_server" name="map_server_roscar" args="$(arg map_file)" output="screen"/>

  <!-- ===================== -->
  <!-- 4. AMCL 定位 -->
  <!-- ===================== -->
  <include file="$(find start_roscar)/launch/include/amcl.launch" />

  <!-- ===================== -->
  <!-- 5. move_base + Navigation -->
  <!-- ===================== -->
  <node pkg="move_base" type="move_base" name="move_base" output="screen">
    <!-- 多点模式下，禁止 move_base 直接消费 RViz 默认单点话题，避免与 multi_waypoint_nav 冲突 -->
    <remap from="/move_base_simple/goal" to="/move_base_simple/goal_single"/>
    <!-- 全局参数 -->
    <rosparam command="load" file="$(find start_roscar)/param/move_base_params.yaml"/>
    <!-- 全局 costmap -->
    <rosparam command="load" file="$(find start_roscar)/param/global_costmap_params.yaml"/>
    <!-- 局部 costmap -->
    <rosparam command="load" file="$(find start_roscar)/param/local_costmap_params.yaml"/>
    <!-- costmap 通用参数 -->
    <rosparam command="load" file="$(find start_roscar)/param/costmap_common_params.yaml"/>
    <!-- Global Planner 参数 -->
    <rosparam command="load" file="$(find start_roscar)/param/base_global_planner_param.yaml"/>
    <!-- TEB Local Planner 参数 -->
    <rosparam command="load" file="$(find start_roscar)/param/teb_local_planner_params.yaml"/>
    <!-- TF 容忍时间 -->
    <param name="transform_tolerance" value="1.0"/>
    <param name="use_sim_time" value="false"/>
  </node>

  <!-- ===================== -->
  <!-- 6. 红绿灯检测（发布 /traffic_light_status） -->
  <!-- ===================== -->
  <node name="traffic_light_yolov8_node"
        pkg="traffic_light_yolo"
        type="traffic_light_yolo.py"
        output="screen">
    <env name="LD_PRELOAD" value="/usr/lib/aarch64-linux-gnu/libgomp.so.1" />
    <param name="model_path" value="$(arg traffic_light_model_path)" />
  </node>

  <!-- ===================== -->
  <!-- 7. 启动时自动对位（AMCL 粒子收敛） -->
  <!-- ===================== -->
  <node pkg="start_roscar" type="wait_for_convergence.py" name="wait_for_convergence" output="screen" required="false"/>

  <!-- ===================== -->
  <!-- 8. 多点导航 -->
  <!-- ===================== -->
  <node pkg="start_roscar" type="multi_waypoint_nav.py" name="multi_waypoint_nav" output="screen" clear_params="true">
    <!-- 路径文件：由 keyboard_teleop.py 遥控录制生成，也可手动编辑 -->
    <param name="path_file" value="$(find start_roscar)/path/patrol_path.yaml"/>
    <!-- multi_waypoint_nav 独占 RViz 目标点输入并入队 -->
    <param name="use_rviz_waypoints" value="true"/>
    <!-- 自动模式：定位就绪后立即开始，无需按 Enter -->
    <param name="require_enter_to_start" value="false"/>
    <rosparam command="load" file="$(find start_roscar)/param/multi_waypoint_nav_params.yaml"/>
  </node>

</launch>
