<launch>
  <!-- =============================== -->
  <!-- 毫米波雷达 ARS408 避障全套管线  -->
  <!-- =============================== -->

  <!-- Step 1: CAN 初始化 -->
  <node name="can_init" pkg="start_roscar" type="multi_waypoint_nav.py"
        launch-prefix="bash -c 'echo 123456 | sudo -S modprobe can; echo 123456 | sudo -S modprobe can_raw; echo 123456 | sudo -S modprobe mttcan; echo 123456 | sudo -S ip link set can0 up type can bitrate 500000; sleep 1'"
        output="screen"/>

  <!-- Step 2: SocketCAN 桥接（CAN 消息 ↔ ROS topic /received_messages） -->
  <node pkg="socketcan_bridge" type="socketcan_bridge_node" name="socketcan_bridge" output="screen">
    <param name="can_device" value="can0"/>
  </node>

  <!-- Step 3: ARS408 雷达驱动（/received_messages → /radar/pointcloud） -->
  <node pkg="ars408_ros" type="ars408_node.py" name="ars408_node" output="screen"/>

  <!-- Step 4: base_link → radar_link 静态 TF -->
  <!-- 注意：不用 tf_publisher.py（它会重复发布 camera_link 造成 TF 冲突） -->
  <node pkg="tf" type="static_transform_publisher" name="radar_broadcaster"
        args="0.10 0 0.30 0 0 0 base_link radar_link 100"/>

  <!-- Step 5: 雷达障碍物检测（/radar/pointcloud → /person_radar/obstacles） -->
  <node name="radar_only_obstacle" pkg="radar_obstacle" type="radar_only_obstacle.py" output="screen">
    <param name="radar_topic" value="/radar/pointcloud"/>
    <param name="target_distance"      value="2.0"/>
    <param name="distance_tolerance"   value="1.5"/>
    <param name="max_angle_deg"        value="45.0"/>
    <param name="rcs_min"             value="-5.0"/>
    <param name="persistence_frames"   value="8"/>
    <param name="persistence_window"   value="10"/>
    <param name="cluster_radius"       value="0.3"/>
    <param name="clear_timeout"        value="99999.0"/>
    <param name="clear_cooldown"       value="1.0"/>
  </node>
</launch>
